# ---- Supabase (database only - Supabase Auth is no longer used) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Service-role / secret key (Settings -> API in Supabase). Code accepts either
# name below - set whichever matches what your Supabase project calls it.
# Every database access now goes through this key exclusively - there is no
# more anon/publishable key in use anywhere in the app.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# SUPABASE_SECRET_KEY=sb_secret_...

# ---- Auth (Auth.js - replaces Supabase Auth) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# ---- Password reset emails (Resend) ----
# https://resend.com - free tier is plenty to start
RESEND_API_KEY=
RESEND_FROM_EMAIL="TimelyMemo <noreply@yourdomain.com>"  # must be a domain verified in Resend

# ---- Email verification ----
# OFF by default so registration/testing isn't blocked before Resend is set
# up - verification emails still get SENT (best-effort) either way once
# RESEND_API_KEY is configured, but login is only actually BLOCKED for
# unverified accounts once you set this to 1.
REQUIRE_EMAIL_VERIFICATION=0

# ---- Gemini (server-side only) ----
GEMINI_API_KEY=AIza...
# Optional overrides (defaults: gemini-3.6-flash / gemini-embedding-001)
# GEMINI_CHAT_MODEL=
# GEMINI_EMBED_MODEL=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=long-random-string

# ---- Web Push (npx web-push generate-vapid-keys) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@timelymemo.app

# ---- Google OAuth (Calendar events + Gmail READ-ONLY, AND Google Sign-In) ----
# Used for both: connecting Calendar/Gmail, and the "Continue with Google"
# login button (which appears automatically whenever these are set - no
# separate flag needed).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# In Google Cloud Console, make sure this exact redirect URI is added to
# that SAME OAuth client (in addition to whatever the Calendar integration
# already uses) for the login button to work:
#   https://YOUR-DOMAIN/api/auth/callback/google

# ---- Paddle Billing ----
# Client token (sandbox or live), the Pro price id, plus server keys:
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_ID=
NEXT_PUBLIC_PADDLE_ENV=          # "sandbox" while testing, empty for production
PADDLE_API_KEY=                  # customer portal sessions + email fallback
PADDLE_WEBHOOK_SECRET=           # from Paddle -> Notifications -> your webhook
